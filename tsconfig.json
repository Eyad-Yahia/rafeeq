{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "declaration": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["."],
  "exclude": ["dist", "node_modules", "demo"]
}
